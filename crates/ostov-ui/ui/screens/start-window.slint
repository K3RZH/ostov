import { Theme, Shape } from "../theme.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { Chip, ChipKind } from "../components/chip.slint";
import { Radio } from "../components/choice.slint";
import { BrandPanel } from "brand-panel.slint";

// protection: 0 без защиты, 1 пользователи, 2 пароль на файл. tag: подпись метки в списке.
export struct RecentDb { name: string, path: string, when: string, tag: string, protection: int }

component ModeCard inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in property <bool> selected;
    callback chosen();

    border-radius: Shape.surface-radius;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent-text : Theme.border;
    background: root.selected ? Theme.accent-soft : Theme.surface;

    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    VerticalLayout {
        padding: Theme.space-16;
        spacing: Theme.space-4;
        Radio {
            text: root.title;
            selected: root.selected;
            clicked => { root.chosen(); }
        }
        HorizontalLayout {
            padding-left: 24px;
            Text {
                text: root.hint;
                font-size: Theme.font-caption;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
        }
    }
}

component RecentRow inherits Rectangle {
    in property <RecentDb> db;
    in property <bool> selected;
    callback chosen();

    height: 52px;
    border-radius: Shape.control-radius;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-alt : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(); }
    }

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        spacing: Theme.space-12;

        VerticalLayout {
            alignment: center;
            Image {
                source: @image-url("../../assets/icons/database.svg");
                colorize: Theme.text;
                width: 20px;
                height: 20px;
            }
        }
        VerticalLayout {
            alignment: center;
            horizontal-stretch: 1;
            Text {
                text: root.db.name;
                font-size: Theme.font-body;
                font-weight: 600;
                color: Theme.text;
            }
            Text {
                text: root.db.path;
                font-size: Theme.font-caption;
                color: Theme.text-muted;
                overflow: elide;
            }
        }
        if root.db.tag != "" : VerticalLayout {
            alignment: center;
            Chip { text: root.db.tag; }
        }
        VerticalLayout {
            alignment: center;
            Text {
                text: root.db.when;
                font-size: Theme.font-caption;
                color: Theme.text-muted;
            }
        }
    }
}

// Окно выбора режима и базы. Данные недавних баз сейчас примерные: их даст ядро (Engine API).
export component StartWindow inherits Window {
    in-out property <int> mode;
    in-out property <int> selected-recent: 0;
    in property <string> config-name: "Управление складом";
    in property <string> config-info: "Конфигурация · версия 1.2.0";
    in property <string> app-version: "Версия 0.1.0";
    in property <[RecentDb]> recent: [
        { name: "Кафе-2026.sqlite", path: "~/Ostov/Кафе-2026.sqlite", when: "вчера", tag: "Пользователи", protection: 1 },
        { name: "Склад-тест.sqlite", path: "~/Ostov/Склад-тест.sqlite", when: "12 октября", tag: "", protection: 0 },
        { name: "Бар-2025.sqlite", path: "~/Документы/Бар-2025.sqlite", when: "3 марта", tag: "Пароль", protection: 2 },
    ];
    callback open();
    callback create-database();
    callback find-file();

    title: "Ostov — Выбор режима";
    preferred-width: 1200px;
    preferred-height: 760px;
    min-width: 960px;
    min-height: 640px;
    default-font-family: "Open Sans";
    background: Theme.bg;

    HorizontalLayout {
        BrandPanel {
            config-name: root.config-name;
            config-info: root.config-info;
        }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                padding-left: Theme.space-24;
                padding-right: Theme.space-24;
                VerticalLayout {
                    min-width: 360px;
                    max-width: 520px;
                    spacing: Theme.space-16;

                    Text {
                        text: "Выберите режим работы";
                        font-size: Theme.font-title;
                        font-weight: 700;
                        color: Theme.text;
                    }
                    ModeCard {
                        title: "Локально";
                        hint: "База хранится в файле на этом компьютере.";
                        selected: root.mode == 0;
                        chosen => { root.mode = 0; }
                    }
                    ModeCard {
                        title: "Сервер";
                        hint: "Общая база для нескольких рабочих мест в локальной сети.";
                        selected: root.mode == 1;
                        chosen => { root.mode = 1; }
                    }
                    Text {
                        text: "Недавние базы";
                        font-size: Theme.font-body;
                        font-weight: 600;
                        color: Theme.text;
                    }
                    VerticalLayout {
                        spacing: Theme.space-4;
                        for db[index] in root.recent : RecentRow {
                            db: db;
                            selected: index == root.selected-recent;
                            chosen => { root.selected-recent = index; }
                        }
                    }
                    HorizontalLayout {
                        spacing: Theme.space-8;
                        Button { text: "Открыть"; kind: ButtonKind.primary; clicked => { root.open(); } }
                        Button { text: "Создать базу"; clicked => { root.create-database(); } }
                        Rectangle { }
                        Button { text: "Найти файл…"; kind: ButtonKind.text; clicked => { root.find-file(); } }
                    }
                    Text {
                        text: root.app-version;
                        font-size: Theme.font-caption;
                        color: Theme.text-muted;
                    }
                }
            }
        }
    }
}
