import { Theme, Shape } from "../theme.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { Chip, ChipKind } from "../components/chip.slint";
import { TextField } from "../components/text-field.slint";
import { Select } from "../components/select.slint";
import { DateField } from "../components/date-field.slint";
import { MenuAction } from "../components/context-menu.slint";
import { ErpGrid, GridColumn, GridMark, GridRow } from "../components/erp-grid.slint";

// Данные и события экрана «Поступления»: список и форма документа.
// Состояние ведёт Rust (src/receipts_ui.rs), здесь только свойства и колбэки.
export global ReceiptsData {
    // Список
    in property <[GridColumn]> columns;
    in property <[GridRow]> rows;
    in property <int> total;
    // Загрузка списка из ядра и текст ошибки (пусто: ошибки нет).
    in property <bool> list-loading;
    in property <string> list-error;
    // Сообщение об ошибке действия над списком (пусто: нет).
    in property <string> notice;
    // Ошибка записи или проведения документа над формой; при конфликте версий есть «Перечитать».
    in property <string> form-error;
    in property <bool> form-conflict;
    callback form-reload();
    in property <int> milestone-step;
    in property <[GridMark]> marks;
    in property <int> sort-column: -1;
    in property <bool> sort-desc;
    in-out property <int> selected-row: -1;
    in-out property <string> query;
    callback sort(int);
    callback open(int);
    callback resize-begin-list();
    callback resize-list(int, length, length);
    callback resize-end-list();
    callback resize-begin-lines();
    callback resize-lines(int, length, length);
    callback resize-end-lines();
    // Меню строки списка: Rust выставляет пункты под строку в menu-opening, действие приходит в action.
    in property <[MenuAction]> menu-actions;
    callback menu-opening(int);
    callback action(int, string);
    // Подтверждение удаления документа.
    in-out property <bool> confirm-open;
    in property <string> confirm-text;
    callback confirm-accepted();
    callback create();
    callback query-changed(string);

    // Форма документа
    in property <string> form-title;
    in property <bool> form-posted;
    in-out property <string> form-number;
    in-out property <int> form-day: 1;
    in-out property <int> form-month: 1;
    in-out property <int> form-year: 2026;
    in-out property <string> form-warehouse;
    in-out property <string> form-supplier;
    in property <[GridColumn]> line-columns;
    in property <[GridRow]> lines;
    in property <string> form-count;
    in property <string> form-total;
    // Значения для выпадающих списков: справочники и перечисления.
    in property <[string]> warehouses;
    in property <[string]> suppliers;
    in property <[string]> goods;
    in-out property <int> line-selected: -1;
    // Меню строки табличной части.
    in property <[MenuAction]> line-menu-actions;
    callback line-menu-opening(int);
    callback line-action(int, string);
    // Окно нового элемента справочника («+ Добавить» в выпадающем списке): kind 0 склад,
    // 1 поставщик, 2 номенклатура.
    in-out property <bool> catalog-open;
    in property <string> catalog-title;
    in property <bool> catalog-has-unit;
    in-out property <string> catalog-name;
    in-out property <string> catalog-unit;
    in property <string> catalog-error;
    callback catalog-add(int);
    callback catalog-confirm();
    // Окно строки табличной части
    in-out property <bool> line-open;
    in property <string> line-title;
    in property <string> line-error;
    in-out property <string> line-name;
    in-out property <string> line-quantity;
    in-out property <string> line-price;
    callback line-add();
    callback line-edit(int);
    callback line-delete();
    callback line-confirm();
    callback line-quantity-edited(string);
    callback line-price-edited(string);
    callback form-post(bool);
    callback form-save();
    callback form-close();
    // Отдельное окно: документ в своём окне (detached) или во вкладке главного окна.
    in-out property <bool> detached;
    callback form-detach();
    callback form-dock();
}

component ReceiptList inherits VerticalLayout {
    padding: Theme.space-24;
    spacing: Theme.space-16;

    Text {
        text: "Поступления товаров";
        font-size: Theme.font-title;
        font-weight: 700;
        color: Theme.text;
    }
    HorizontalLayout {
        spacing: Theme.space-8;
        Button {
            text: "Создать";
            kind: ButtonKind.primary;
            clicked => { ReceiptsData.create(); }
        }
        Button {
            text: "Открыть";
            enabled: ReceiptsData.selected-row >= 0;
            clicked => { ReceiptsData.open(ReceiptsData.selected-row); }
        }
        Rectangle { }
        TextField {
            width: 280px;
            placeholder: "Поиск по списку";
            text <=> ReceiptsData.query;
            edited(text) => { ReceiptsData.query-changed(text); }
        }
    }
    ErpGrid {
        vertical-stretch: 1;
        columns: ReceiptsData.columns;
        rows: ReceiptsData.rows;
        empty-text: ReceiptsData.list-loading ? "Загрузка…" : ReceiptsData.list-error != "" ? ReceiptsData.list-error : "Ничего не найдено";
        milestone-step: ReceiptsData.milestone-step;
        marks: ReceiptsData.marks;
        actions: ReceiptsData.menu-actions;
        menu-opening(i) => { ReceiptsData.menu-opening(i); }
        action-chosen(i, id) => { ReceiptsData.action(i, id); }
        sort-column: ReceiptsData.sort-column;
        sort-desc: ReceiptsData.sort-desc;
        selected-row <=> ReceiptsData.selected-row;
        resize-begin => { ReceiptsData.resize-begin-list(); }
        resize-column(i, delta, width) => { ReceiptsData.resize-list(i, delta, width); }
        resize-end => { ReceiptsData.resize-end-list(); }
        sort-clicked(i) => { ReceiptsData.sort(i); }
        row-activated(i) => { ReceiptsData.open(i); }
    }
    HorizontalLayout {
        alignment: start;
        spacing: Theme.space-16;
        Text {
            text: "Показано " + ReceiptsData.rows.length + " из " + ReceiptsData.total;
            font-size: Theme.font-caption;
            color: Theme.text-muted;
        }
        if ReceiptsData.notice != "" : Text {
            text: ReceiptsData.notice;
            font-size: Theme.font-caption;
            color: Theme.danger;
            horizontal-alignment: left;
            overflow: elide;
        }
    }
}

component ReceiptForm inherits VerticalLayout {
    padding: Theme.space-24;
    spacing: Theme.space-16;

    HorizontalLayout {
        spacing: Theme.space-12;
        Text {
            text: ReceiptsData.form-title;
            font-size: Theme.font-title;
            font-weight: 700;
            color: Theme.text;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            Chip {
                text: ReceiptsData.form-posted ? "Проведён" : "Черновик";
                kind: ReceiptsData.form-posted ? ChipKind.posted : ChipKind.draft;
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-8;
        Button {
            text: "Провести и закрыть";
            kind: ButtonKind.primary;
            clicked => { ReceiptsData.form-post(true); }
        }
        Button { text: "Провести"; clicked => { ReceiptsData.form-post(false); } }
        Button { text: "Записать"; clicked => { ReceiptsData.form-save(); } }
        Rectangle { }
        if !ReceiptsData.detached : Button {
            text: "В отдельное окно";
            kind: ButtonKind.text;
            clicked => { ReceiptsData.form-detach(); }
        }
        if ReceiptsData.detached : Button {
            text: "Вернуть во вкладки";
            kind: ButtonKind.text;
            clicked => { ReceiptsData.form-dock(); }
        }
        Button { text: "Закрыть"; kind: ButtonKind.text; clicked => { ReceiptsData.form-close(); } }
    }
    if ReceiptsData.form-error != "" : Rectangle {
        border-radius: Shape.surface-radius;
        background: Theme.danger-soft;
        height: banner-row.preferred-height + 2 * Theme.space-8;
        banner-row := HorizontalLayout {
            padding: Theme.space-8;
            spacing: Theme.space-12;
            Text {
                text: ReceiptsData.form-error;
                font-size: Theme.font-body;
                color: Theme.danger;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if ReceiptsData.form-conflict : Button {
                text: "Перечитать";
                clicked => { ReceiptsData.form-reload(); }
            }
        }
    }
    Rectangle {
        border-radius: Shape.surface-radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;
        height: card.preferred-height;
        card := HorizontalLayout {
            padding: Theme.space-16;
            spacing: Theme.space-16;
            TextField { width: 100px; label: "Номер"; read-only: true; text <=> ReceiptsData.form-number; }
            DateField {
                width: 140px;
                label: "Дата";
                day <=> ReceiptsData.form-day;
                month <=> ReceiptsData.form-month;
                year <=> ReceiptsData.form-year;
            }
            Select {
                width: 180px;
                label: "Склад";
                options: ReceiptsData.warehouses;
                addable: true;
                text <=> ReceiptsData.form-warehouse;
                add-requested => { ReceiptsData.catalog-add(0); }
            }
            Select {
                horizontal-stretch: 1;
                label: "Поставщик";
                options: ReceiptsData.suppliers;
                addable: true;
                text <=> ReceiptsData.form-supplier;
                add-requested => { ReceiptsData.catalog-add(1); }
            }
        }
    }
    HorizontalLayout {
        spacing: Theme.space-8;
        Text {
            text: "Товары";
            font-size: Theme.font-subtitle;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
        Rectangle { }
        Button {
            text: "Добавить";
            control-height: Theme.control-sm;
            clicked => { ReceiptsData.line-add(); }
        }
        Button {
            text: "Удалить";
            control-height: Theme.control-sm;
            enabled: ReceiptsData.line-selected >= 0;
            clicked => { ReceiptsData.line-delete(); }
        }
    }
    ErpGrid {
        vertical-stretch: 1;
        columns: ReceiptsData.line-columns;
        rows: ReceiptsData.lines;
        empty-text: "Товаров пока нет: нажмите «Добавить»";
        selected-row <=> ReceiptsData.line-selected;
        actions: ReceiptsData.line-menu-actions;
        menu-opening(i) => { ReceiptsData.line-menu-opening(i); }
        action-chosen(i, id) => { ReceiptsData.line-action(i, id); }
        resize-begin => { ReceiptsData.resize-begin-lines(); }
        resize-column(i, delta, width) => { ReceiptsData.resize-lines(i, delta, width); }
        resize-end => { ReceiptsData.resize-end-lines(); }
        row-activated(i) => { ReceiptsData.line-edit(i); }
    }
    // Итоги: слева число позиций, справа сумма документа.
    HorizontalLayout {
        Text {
            text: ReceiptsData.form-count;
            font-size: Theme.font-body;
            color: Theme.text-muted;
            vertical-alignment: center;
        }
        Rectangle { }
        Text {
            text: "Итого: " + ReceiptsData.form-total;
            font-size: Theme.font-body;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
        }
    }
}

// Окно строки табличной части: товар из справочника, количество, цена.
component LineDialog inherits Rectangle {
    background: Theme.scrim;

    TouchArea { }

    card := Rectangle {
        width: min(480px, root.width - 2 * Theme.space-24);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(Theme.space-24, (root.height - self.height) / 2);
        border-radius: Shape.surface-radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;

        content := VerticalLayout {
            padding: Theme.space-24;
            spacing: Theme.space-16;
            Text {
                text: ReceiptsData.line-title;
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
            }
            Select {
                label: "Номенклатура";
                options: ReceiptsData.goods;
                addable: true;
                text <=> ReceiptsData.line-name;
                add-requested => { ReceiptsData.catalog-add(2); }
            }
            HorizontalLayout {
                spacing: Theme.space-12;
                TextField {
                    label: "Количество";
                    numeric: true;
                    placeholder: "0,0";
                    text <=> ReceiptsData.line-quantity;
                    edited(text) => { ReceiptsData.line-quantity-edited(text); }
                }
                TextField {
                    label: "Цена";
                    numeric: true;
                    placeholder: "0,00";
                    text <=> ReceiptsData.line-price;
                    edited(text) => { ReceiptsData.line-price-edited(text); }
                }
            }
            if ReceiptsData.line-error != "" : Text {
                text: ReceiptsData.line-error;
                font-size: Theme.font-caption;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-12;
                alignment: end;
                Button { text: "Отмена"; clicked => { ReceiptsData.line-open = false; } }
                Button {
                    text: "Готово";
                    kind: ButtonKind.primary;
                    clicked => { ReceiptsData.line-confirm(); }
                }
            }
        }
    }
}

// Окно нового элемента справочника: наименование (для номенклатуры ещё единица).
component CatalogDialog inherits Rectangle {
    background: Theme.scrim;

    TouchArea { }

    card := Rectangle {
        width: min(400px, root.width - 2 * Theme.space-24);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(Theme.space-24, (root.height - self.height) / 2);
        border-radius: Shape.surface-radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;

        content := VerticalLayout {
            padding: Theme.space-24;
            spacing: Theme.space-16;
            Text {
                text: ReceiptsData.catalog-title;
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
            }
            TextField {
                label: "Наименование";
                text <=> ReceiptsData.catalog-name;
            }
            if ReceiptsData.catalog-has-unit : TextField {
                label: "Единица измерения";
                placeholder: "шт, кг, л";
                text <=> ReceiptsData.catalog-unit;
            }
            if ReceiptsData.catalog-error != "" : Text {
                text: ReceiptsData.catalog-error;
                font-size: Theme.font-caption;
                color: Theme.danger;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-12;
                alignment: end;
                Button { text: "Отмена"; clicked => { ReceiptsData.catalog-open = false; } }
                Button {
                    text: "Создать";
                    kind: ButtonKind.primary;
                    clicked => { ReceiptsData.catalog-confirm(); }
                }
            }
        }
    }
}

// Подтверждение удаления документа из списка.
component ConfirmDialog inherits Rectangle {
    background: Theme.scrim;

    TouchArea { }

    card := Rectangle {
        width: min(420px, root.width - 2 * Theme.space-24);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(Theme.space-24, (root.height - self.height) / 2);
        border-radius: Shape.surface-radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;

        content := VerticalLayout {
            padding: Theme.space-24;
            spacing: Theme.space-16;
            Text {
                text: "Удалить документ?";
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: ReceiptsData.confirm-text;
                font-size: Theme.font-body;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            HorizontalLayout {
                spacing: Theme.space-12;
                alignment: end;
                Button { text: "Отмена"; clicked => { ReceiptsData.confirm-open = false; } }
                Button {
                    text: "Удалить";
                    kind: ButtonKind.primary;
                    clicked => { ReceiptsData.confirm-accepted(); }
                }
            }
        }
    }
}

// Вкладка «Поступления товаров»: только список; документ открывается в своей вкладке.
export component ReceiptsView inherits Rectangle {
    background: Theme.bg;

    ReceiptList {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
    }
    if ReceiptsData.confirm-open : ConfirmDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
    }
}

// Вкладка документа «Поступление»: форма с табличной частью; окно строки поверх неё.
export component ReceiptFormView inherits Rectangle {
    background: Theme.bg;

    ReceiptForm {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
    }
    if ReceiptsData.line-open : LineDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
    }
    if ReceiptsData.catalog-open : CatalogDialog {
        x: 0px;
        y: 0px;
        width: parent.width;
        height: parent.height;
    }
}
