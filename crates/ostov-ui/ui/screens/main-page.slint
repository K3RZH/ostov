import { Theme, Shape } from "../theme.slint";
import { Icon } from "../components/icon.slint";
import { IconButton } from "../components/icon-button.slint";
import { WindowControls } from "../components/window-controls.slint";
import { UserRow } from "users-view.slint";
import { TabHost, TabItem } from "tab-host.slint";
import { MenuAction } from "../components/context-menu.slint";
import { NavPanel, NavRow } from "../components/nav-panel.slint";

component Separator inherits Rectangle {
    width: 1px;
    height: 20px;
    background: Theme.border;
}

// Главная страница: шапка, навигация, вкладки, содержимое, строка состояния.
// База, режим и пользователь приходят из Rust (src/app.rs) после открытия базы.
export component MainPage inherits Rectangle {
    in property <string> base-name;
    in property <string> database-name;
    in property <string> mode-text;
    in property <string> user-text;
    in property <string> user-initials;
    in property <string> status-message: "Готово";
    in property <string> app-version: "v0.1.0";
    in property <[NavRow]> nav;
    in property <[TabItem]> tabs;
    in property <int> active-tab;
    in-out property <bool> nav-collapsed;
    in-out property <string> search;
    callback nav-clicked(int);
    callback tab-selected(int);
    callback tab-closed(int);
    callback tab-detached(int);
    callback tab-reordered(int, int);
    callback tab-drag-moved(int, length, length, bool);
    callback tab-drag-ended(int, length, length, bool);
    in property <bool> drop-target;
    in property <int> insert-at: -1;
    in property <bool> follower-active;
    out property <length> strip-left <=> tab-host.strip-left;
    out property <length> strip-top <=> tab-host.strip-top;
    out property <length> strip-width <=> tab-host.strip-width;
    out property <length> strip-tab-width <=> tab-host.strip-tab-width;
    // Кнопки окна: свою панель окна здесь заменяет шапка.
    in property <bool> maximized;
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback settings-clicked();

    // Вкладка «Пользователи и роли»
    in property <[UserRow]> users;
    in property <string> user-message;
    callback user-add-clicked();
    callback user-toggle(int);

    background: Theme.bg;

    VerticalLayout {
        // Шапка
        Rectangle {
            height: 48px;
            background: Theme.surface;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            // Пустые места шапки двигают окно, двойной клик разворачивает.
            WindowMoveArea {
                TouchArea {
                    double-clicked => { root.toggle-maximize(); }
                }
            }
            WindowControls {
                x: parent.width - 3 * 46px;
                width: 3 * 46px;
                height: parent.height;
                maximized: root.maximized;
                minimize => { root.minimize(); }
                toggle-maximize => { root.toggle-maximize(); }
                close-window => { root.close-window(); }
            }
            HorizontalLayout {
                padding-left: Theme.space-12;
                padding-right: Theme.space-12 + 3 * 46px;
                spacing: Theme.space-12;
                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../../assets/logo.png");
                        image-fit: contain;
                        width: 65px;
                        height: 40px;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    Text { text: "Ostov"; font-size: Theme.font-subtitle; font-weight: 600; color: Theme.text; }
                }
                VerticalLayout { alignment: center; Separator { } }
                VerticalLayout {
                    alignment: center;
                    Text { text: root.base-name; font-size: Theme.font-body; color: Theme.text-muted; }
                }
                Rectangle { horizontal-stretch: 1; }
                Rectangle {
                    width: 400px;
                    horizontal-stretch: 0;
                    VerticalLayout {
                        alignment: center;
                        Rectangle {
                            height: 32px;
                            border-radius: Shape.control-radius;
                            background: Theme.surface-alt;
                            border-width: 1px;
                            border-color: Theme.border;
                            HorizontalLayout {
                                padding-left: Theme.space-8;
                                padding-right: Theme.space-8;
                                spacing: Theme.space-8;
                                VerticalLayout { alignment: center; Icon { name: "search"; tint: Theme.text-muted; width: 16px; height: 16px; } }
                                Rectangle {
                                    horizontal-stretch: 1;
                                    TextInput {
                                        width: parent.width;
                                        height: parent.height;
                                        single-line: true;
                                        vertical-alignment: center;
                                        font-size: Theme.font-body;
                                        color: Theme.text;
                                        text <=> root.search;
                                    }
                                    if root.search == "" : Text {
                                        x: 0px;
                                        width: parent.width;
                                        text: "Поиск по системе";
                                        font-size: Theme.font-body;
                                        color: Theme.text-muted;
                                        vertical-alignment: center;
                                        horizontal-alignment: left;
                                    }
                                }
                                VerticalLayout { alignment: center; Text { text: "Ctrl+K"; font-size: Theme.font-caption; color: Theme.text-muted; } }
                            }
                        }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; IconButton { icon: "plus"; } }
                VerticalLayout { alignment: center; IconButton { icon: "bell"; } }
                VerticalLayout { alignment: center; IconButton { icon: "help"; } }
                VerticalLayout { alignment: center; IconButton { icon: "settings"; clicked => { root.settings-clicked(); } } }
                VerticalLayout {
                    alignment: center;
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: Theme.accent-soft;
                        Text { text: root.user-initials; font-size: Theme.font-caption; font-weight: 600; color: Theme.accent-text; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }
        }

        HorizontalLayout {
            // Навигация
            NavPanel {
                rows: root.nav;
                collapsed <=> root.nav-collapsed;
                clicked(id) => { root.nav-clicked(id); }
            }

            tab-host := TabHost {
                tabs: root.tabs;
                active-tab: root.active-tab;
                users: root.users;
                user-message: root.user-message;
                tab-selected(i) => { root.tab-selected(i); }
                tab-closed(i) => { root.tab-closed(i); }
                tab-detached(i) => { root.tab-detached(i); }
                tab-reordered(from, to) => { root.tab-reordered(from, to); }
                tab-drag-moved(i, x, y, out) => { root.tab-drag-moved(i, x, y, out); }
                tab-drag-ended(i, x, y, out) => { root.tab-drag-ended(i, x, y, out); }
                drop-target: root.drop-target;
                insert-at: root.insert-at;
                follower-active: root.follower-active;
                user-add-clicked => { root.user-add-clicked(); }
                user-toggle(i) => { root.user-toggle(i); }
            }
        }

        // Строка состояния
        Rectangle {
            height: 24px;
            background: Theme.surface-alt;
            Rectangle {
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-left: Theme.space-12;
                padding-right: Theme.space-12;
                spacing: Theme.space-12;
                VerticalLayout { alignment: center; Icon { name: "database"; tint: Theme.text-muted; width: 14px; height: 14px; } }
                VerticalLayout { alignment: center; Text { text: root.database-name; font-size: Theme.font-caption; color: Theme.text-muted; } }
                VerticalLayout { alignment: center; Text { text: root.mode-text; font-size: Theme.font-caption; color: Theme.text-muted; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Icon { name: "success"; tint: Theme.accent-text; width: 14px; height: 14px; } }
                VerticalLayout { alignment: center; Text { text: root.status-message; font-size: Theme.font-caption; color: Theme.text; } }
                Rectangle { horizontal-stretch: 1; }
                VerticalLayout { alignment: center; Icon { name: "user"; tint: Theme.text-muted; width: 14px; height: 14px; } }
                VerticalLayout { alignment: center; Text { text: root.user-text; font-size: Theme.font-caption; color: Theme.text-muted; } }
                VerticalLayout { alignment: center; Text { text: root.app-version; font-size: Theme.font-caption; color: Theme.text-muted; } }
            }
        }
    }


}
