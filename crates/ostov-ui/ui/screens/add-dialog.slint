import { Theme, Shape } from "../theme.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { TextField } from "../components/text-field.slint";
import { ModeOption } from "create-dialog.slint";
import { ErrorBanner } from "../components/error-banner.slint";

// Окно «Добавить существующую базу»: готовый файл на этом компьютере или база на сервере.
export component AddDialog inherits Rectangle {
    in-out property <bool> server;
    in-out property <string> file;
    in-out property <string> address;
    in-out property <string> cert;
    in-out property <string> db-name;
    // Ошибка ядра (файл не база Ostov, его нет) и «идёт проверка».
    in property <string> error;
    in property <bool> busy;
    callback confirmed();
    callback cancelled();
    callback choose-file();
    callback choose-cert();

    private property <bool> valid: root.server ? root.address != "" && root.db-name != "" && root.cert != "" : root.file != "";

    background: Theme.scrim;

    TouchArea { }

    card := Rectangle {
        width: min(560px, root.width - 2 * Theme.space-24);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: max(Theme.space-24, (root.height - self.height) / 2);
        border-radius: Shape.surface-radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;

        content := VerticalLayout {
            padding: Theme.space-24;
            spacing: Theme.space-16;

            Text {
                text: "Добавить существующую базу";
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
            }
            HorizontalLayout {
                spacing: Theme.space-12;
                ModeOption {
                    title: "Файл";
                    hint: "Готовая база на этом компьютере";
                    icon: @image-url("../../assets/icons/database.svg");
                    selected: !root.server;
                    chosen => { root.server = false; }
                }
                ModeOption {
                    title: "Сервер";
                    hint: "Подключиться к общей базе";
                    icon: @image-url("../../assets/icons/server.svg");
                    selected: root.server;
                    chosen => { root.server = true; }
                }
            }

            if !root.server : HorizontalLayout {
                spacing: Theme.space-8;
                TextField {
                    label: "Файл базы";
                    text <=> root.file;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    width: 112px;
                    alignment: end;
                    Button { text: "Выбрать…"; clicked => { root.choose-file(); } }
                }
            }
            if root.server : TextField {
                label: "Адрес сервера";
                placeholder: "server.local:7700";
                text <=> root.address;
            }
            if root.server : HorizontalLayout {
                spacing: Theme.space-8;
                TextField {
                    label: "Сертификат сервера (server.crt)";
                    placeholder: "файл, который сервер создал при первом запуске";
                    text <=> root.cert;
                    horizontal-stretch: 1;
                }
                VerticalLayout {
                    width: 112px;
                    alignment: end;
                    Button { text: "Выбрать…"; clicked => { root.choose-cert(); } }
                }
            }
            if root.server : TextField {
                label: "Название в списке";
                text <=> root.db-name;
            }

            if root.error != "" : ErrorBanner { text: root.error; }

            HorizontalLayout {
                spacing: Theme.space-12;
                alignment: end;
                Button { text: "Отмена"; clicked => { root.cancelled(); } }
                Button {
                    text: root.busy ? "Проверяем…" : "Добавить";
                    kind: ButtonKind.primary;
                    enabled: root.valid && !root.busy;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
