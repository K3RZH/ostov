import { Theme, Shape } from "../theme.slint";
import { Button, ButtonKind } from "../components/button.slint";
import { TextField } from "../components/text-field.slint";
import { ErrorBanner } from "../components/error-banner.slint";

// Окно «Новый пароль» для пользователя из списка «Пользователи и роли». Правила пароля знает
// ядро: на одном компьютере подходит любой (ADR-033), на сервере от 12 символов.
export component PasswordDialog inherits Rectangle {
    in property <string> login;
    in property <string> error;
    in-out property <string> password;
    in-out property <string> repeat;
    callback confirmed();
    callback cancelled();

    private property <bool> mismatch: root.password != root.repeat;

    background: Theme.scrim;

    TouchArea { }

    card := Rectangle {
        width: min(480px, root.width - 2 * Theme.space-24);
        height: content.preferred-height;
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        border-radius: Shape.surface-radius;
        border-width: 1px;
        border-color: Theme.border;
        background: Theme.surface;

        content := VerticalLayout {
            padding: Theme.space-24;
            spacing: Theme.space-16;

            Text {
                text: "Новый пароль";
                font-size: Theme.font-title;
                font-weight: 700;
                color: Theme.text;
            }
            Text {
                text: "Пользователь «" + root.login + "». Его сессии на сервере закроются.";
                font-size: Theme.font-body;
                color: Theme.text-muted;
                wrap: word-wrap;
            }
            TextField { label: "Новый пароль"; password: true; text <=> root.password; }
            TextField {
                label: "Повторите пароль";
                password: true;
                text <=> root.repeat;
                error: root.mismatch && root.repeat != "" ? "!" : "";
            }
            if root.error != "" : ErrorBanner { text: root.error; }
            HorizontalLayout {
                spacing: Theme.space-12;
                Text {
                    text: root.mismatch && root.repeat != "" ? "Пароли не совпадают." : "";
                    horizontal-stretch: 1;
                    font-size: Theme.font-caption;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Button { text: "Отмена"; clicked => { root.cancelled(); } }
                Button {
                    text: "Сменить";
                    kind: ButtonKind.primary;
                    enabled: !root.mismatch;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
