import { Theme, Shape } from "../theme.slint";
import { Icon } from "icon.slint";
import { Chip, ChipKind } from "chip.slint";
import { MenuAction, MenuMetrics, MenuPanel } from "context-menu.slint";
import { ListView } from "std-widgets.slint";

// flex: главная колонка, забирает свободную ширину (у неё width это минимум).
// right: числа и суммы выравниваются вправо. status: значение показывается чипом статуса.
export struct GridColumn { title: string, width: length, right: bool, flex: bool, status: bool }
// muted: строка приглушена (например помечена на удаление). milestone: на строке своя веха.
export struct GridRow { cells: [string], muted: bool, milestone: bool }

// Своя веха: номер строки (с нуля) и наименование объекта (стандартное поле, у поступлений
// это поставщик), оно показывается в подсказке отметки.
export struct GridMark { row: int, label: string }

// Ширина полосы прокрутки: шапка и строки отступают на неё поровну, чтобы колонки совпадали.
global GridMetrics {
    out property <length> track-width: 14px;
}

component HeaderCell inherits Rectangle {
    in property <GridColumn> spec;
    // Состояние сортировки колонки: 0 нет, 1 по возрастанию, 2 по убыванию; приоритет с единицы.
    in property <int> sort-dir;
    in property <int> priority;
    // Сортируют по нескольким колонкам: рядом со значком стоит номер приоритета.
    in property <bool> multi;
    // У последней колонки ручки нет: её правый край это край таблицы.
    in property <bool> resizable: true;
    // Колонка, ручку которой тянут сейчас (подсвечивается).
    in property <bool> dragging;
    callback clicked();
    // Правая кнопка: координаты нажатия в окне.
    callback context(length, length);
    // Ручку тянут: начало, смещение мыши от точки нажатия (точное, ручка при этом не
    // движется), конец. Ширина меняется сразу, на каждом движении.
    callback drag-start();
    callback drag-move(length);
    callback drag-end();

    horizontal-stretch: root.spec.flex ? 1 : 0;
    min-width: root.spec.width;
    max-width: root.spec.flex ? 100000px : root.spec.width;
    background: root.dragging ? Theme.accent-soft : touch.has-hover ? Theme.border : transparent;

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        padding-left: Theme.space-12;
        padding-right: Theme.space-12;
        spacing: Theme.space-4;
        if root.spec.right : Rectangle { }
        // У колонки слева подпись занимает всё место, и значок сортировки стоит у правого края
        // (у числовой колонки подпись прижата вправо, значок сразу за ней).
        Text {
            text: root.spec.title;
            font-size: Theme.font-caption;
            font-weight: 600;
            color: Theme.text;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: root.spec.right ? 0 : 1;
        }
        if root.sort-dir != 0 : VerticalLayout {
            alignment: center;
            Icon {
                name: root.sort-dir == 2 ? "sort-desc" : "sort-asc";
                tint: Theme.accent-text;
                width: 16px;
                height: 16px;
            }
        }
        if root.sort-dir != 0 && root.multi : Text {
            text: root.priority;
            font-size: Theme.font-caption;
            font-weight: 600;
            color: Theme.accent-text;
            vertical-alignment: center;
        }
    }

    private property <bool> grabbed;
    private property <length> grab-x;
    private property <length> press-x;

    // Ручка-разделитель: черта 1 px, при наведении область 10 px и черта 2 px акцентом.
    // Пока ручку тянут, она стоит на месте (левый край колонки не двигается, а правый уезжает
    // за мышью): иначе её координаты мыши отстают на кадр и колонка дёргается.
    handle := TouchArea {
        x: root.grabbed ? root.grab-x : parent.width - 10px;
        width: 10px;
        enabled: root.resizable;
        mouse-cursor: root.resizable ? MouseCursor.col-resize : MouseCursor.default;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.grab-x = root.width - 10px;
                root.grabbed = true;
                root.press-x = self.mouse-x;
                root.drag-start();
            } else if (event.kind == PointerEventKind.up || event.kind == PointerEventKind.cancel) {
                root.grabbed = false;
                root.drag-end();
            }
        }
        moved => {
            if (self.pressed) {
                root.drag-move(self.mouse-x - root.press-x);
            }
        }
    }
    Rectangle {
        x: parent.width - (handle.has-hover || root.dragging ? 2px : 1px);
        y: (parent.height - self.height) / 2;
        width: handle.has-hover || root.dragging ? 2px : 1px;
        height: handle.has-hover || root.dragging ? parent.height : 20px;
        background: handle.has-hover || root.dragging ? Theme.accent-text : Theme.border-strong;
    }
}

// Отметка на полосе прокрутки: черта, при наведении подсказка с номером строки, клик
// прокручивает к строке. Своя веха заметнее: длиннее, толще, цвет акцента.
component TrackTick inherits Rectangle {
    in property <int> number;
    in property <bool> mine;
    in property <string> label;
    callback jump();

    width: GridMetrics.track-width;
    height: 9px;

    Rectangle {
        x: 2px;
        y: (parent.height - self.height) / 2;
        width: root.mine ? 10px : 6px;
        height: root.mine ? 2px : 1px;
        background: root.mine ? Theme.accent-text : Theme.border-strong;
    }

    touch := TouchArea {
        mouse-cursor: MouseCursor.pointer;
        clicked => { root.jump(); }
    }

    if touch.has-hover : Rectangle {
        width: tip.preferred-width + 16px;
        height: 24px;
        x: -self.width - 6px;
        y: (parent.height - self.height) / 2;
        border-radius: Shape.control-radius;
        background: Theme.text;
        tip := Text {
            text: (root.mine ? "Веха · строка " : "Строка ") + root.number
                + (root.label != "" ? " · " + root.label : "");
            font-size: Theme.font-caption;
            color: Theme.bg;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

component GridRowView inherits Rectangle {
    in property <GridRow> item;
    in property <[GridColumn]> columns;
    in property <bool> selected;
    callback clicked();
    callback activated();
    // Правая кнопка: координаты нажатия в окне.
    callback context(length, length);

    height: Theme.row-height;
    background: root.selected ? Theme.accent-soft : touch.has-hover ? Theme.surface-alt : transparent;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.border;
    }

    touch := TouchArea {
        clicked => { root.clicked(); }
        double-clicked => { root.activated(); }
        pointer-event(event) => {
            if (event.button == PointerEventButton.right && event.kind == PointerEventKind.up) {
                root.context(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
            }
        }
    }

    HorizontalLayout {
        for col[i] in root.columns : Rectangle {
            horizontal-stretch: col.flex ? 1 : 0;
            min-width: col.width;
            max-width: col.flex ? 100000px : col.width;
            if !col.status : Rectangle {
                cell-text := Text {
                    x: Theme.space-12;
                    width: parent.width - 2 * Theme.space-12;
                    height: parent.height;
                    text: root.item.cells[i];
                    font-size: Theme.font-body;
                    font-weight: root.selected ? 600 : 400;
                    color: root.item.muted ? Theme.disabled-text : Theme.text;
                    horizontal-alignment: col.right ? right : left;
                    vertical-alignment: center;
                    overflow: elide;
                }
                // По макету вертикальных линий в теле нет: черта на границе колонки появляется
                // только в строках, где текст обрезан «…» или почти упирается в границу.
                if i < root.columns.length - 1 && cell-text.preferred-width > cell-text.width - Theme.space-4 : Rectangle {
                    x: parent.width - 1px;
                    y: (parent.height - self.height) / 2;
                    width: 1px;
                    height: 20px;
                    background: Theme.border-strong;
                }
            }
            if col.status : Chip {
                x: Theme.space-12;
                y: (parent.height - self.height) / 2;
                text: root.item.cells[i];
                kind: root.item.cells[i] == "Проведён" ? ChipKind.posted
                    : root.item.cells[i] == "Черновик" ? ChipKind.draft
                    : root.item.cells[i] == "Записан" ? ChipKind.saved
                    : ChipKind.neutral;
            }
        }
    }
}

// Таблица ErpGrid по макету: шапка с сортировкой и ручками колонок, строки без вертикальных
// линий, внешний контур скруглён, строки и шапка с прямыми углами, главная колонка гибкая.
// Полоса прокрутки своя: ползунок, отметки-вехи (ADR-014) и подсказка «Строка N из M».
// Данные и сортировку ведёт Rust; ширины колонок меняются здесь, перетаскиванием.
export component ErpGrid inherits Rectangle {
    in property <[GridColumn]> columns;
    in property <[GridRow]> rows;
    in property <string> empty-text: "Нет данных";
    // Сортировка по колонкам (список поступлений): направление и приоритет каждой колонки,
    // сколько колонок отсортировано. Меню заголовка (правая кнопка) меняет сортировку.
    in property <bool> sortable: false;
    in property <[int]> sort-dirs;
    in property <[int]> sort-priorities;
    in property <int> sort-count: 0;
    callback sort-action(int, string);
    // Шаг вех в строках (0: без вех). Для длинных списков задаёт вызывающий.
    in property <int> milestone-step: 0;
    // Свои вехи пользователя: отметки на полосе прокрутки.
    // marks: вехи (строка с нуля и наименование); у самих строк тоже стоит `milestone`.
    in property <[GridMark]> marks;
    // Меню строки по правой кнопке: перед показом вызывается menu-opening(строка), владелец
    // выставляет `actions` под эту строку (подписи и доступность зависят от её состояния).
    // Пустой список: меню не показывается.
    in property <[MenuAction]> actions;
    in-out property <int> selected-row: -1;
    callback menu-opening(int);
    callback action-chosen(int, string);
    callback sort-clicked(int);
    callback row-activated(int);
    // Ширина колонки меняется на каждом движении ручки: начало, смещение от точки нажатия
    // (колонка, смещение, ширина области колонок), конец. Ширины пересчитывает вызывающий
    // (src/grid.rs) от ширин на момент начала, поэтому ошибки не накапливаются.
    callback resize-begin();
    callback resize-column(int, length, length);
    callback resize-end();

    border-radius: Shape.surface-radius;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;

    // Какая колонка меняет ширину сейчас (подсвечивается).
    private property <int> drag-index: -1;
    // Меню строки: куда открыть и для какой строки.
    private property <length> menu-x;
    private property <length> menu-y;
    private property <int> menu-row: -1;
    // Меню заголовка: для какой колонки и куда открыто.
    private property <length> head-menu-x;
    private property <length> head-menu-y;
    private property <int> head-menu-col: -1;
    pure function dir-of(i: int) -> int {
        i >= 0 && i < root.sort-dirs.length ? root.sort-dirs[i] : 0
    }
    pure function priority-of(i: int) -> int {
        i >= 0 && i < root.sort-priorities.length ? root.sort-priorities[i] : 0
    }

    VerticalLayout {
        Rectangle {
            height: 36px;
            background: Theme.surface-alt;
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border;
            }
            HorizontalLayout {
                padding-right: GridMetrics.track-width;
                for col[i] in root.columns : HeaderCell {
                    spec: col;
                    sort-dir: root.dir-of(i);
                    priority: root.priority-of(i);
                    multi: root.sort-count > 1;
                    resizable: i < root.columns.length - 1;
                    dragging: i == root.drag-index;
                    clicked => { root.sort-clicked(i); }
                    context(ax, ay) => {
                        if (root.sortable) {
                            root.head-menu-col = i;
                            root.head-menu-x = min(ax - root.absolute-position.x, root.width - MenuMetrics.width - 4px);
                            root.head-menu-y = 36px;
                            head-menu.show();
                        }
                    }
                    drag-start => {
                        root.drag-index = i;
                        root.resize-begin();
                    }
                    drag-move(offset) => {
                        root.resize-column(i, offset, root.width - GridMetrics.track-width - 2px);
                    }
                    drag-end => {
                        root.drag-index = -1;
                        root.resize-end();
                    }
                }
            }
        }
        if root.rows.length == 0 : Rectangle {
            Text {
                text: root.empty-text;
                font-size: Theme.font-body;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
        if root.rows.length > 0 : Rectangle {
            list := ListView {
                x: 0px;
                width: parent.width - GridMetrics.track-width;
                height: parent.height;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                for row[i] in root.rows : GridRowView {
                    item: row;
                    columns: root.columns;
                    selected: i == root.selected-row;
                    clicked => { root.selected-row = i; }
                    activated => { root.row-activated(i); }
                    context(ax, ay) => {
                        root.selected-row = i;
                        root.menu-row = i;
                        root.menu-opening(i);
                        if (root.actions.length > 0) {
                            // Не помещается снизу: открываем вверх от точки нажатия.
                            root.menu-x = min(ax - root.absolute-position.x, root.width - MenuMetrics.width - 4px);
                            root.menu-y = ay - root.absolute-position.y + MenuMetrics.height(root.actions.length) > root.height
                                && ay - root.absolute-position.y - MenuMetrics.height(root.actions.length) >= 0
                                ? ay - root.absolute-position.y - MenuMetrics.height(root.actions.length)
                                : ay - root.absolute-position.y;
                            menu.show();
                        }
                    }
                }
            }

            // Полоса прокрутки
            track := Rectangle {
                x: parent.width - GridMetrics.track-width;
                width: GridMetrics.track-width;
                height: parent.height;
                background: Theme.surface-alt;

                private property <length> total: list.content-height;
                private property <length> view-h: list.visible-height;
                private property <length> scroll-range: max(0px, self.total - self.view-h);
                private property <length> thumb-height: max(28px, self.height * self.view-h / max(1px, self.total));
                private property <length> thumb-free: max(1px, self.height - self.thumb-height);
                private property <length> thumb-y: self.scroll-range > 0 ? (-list.content-y / self.scroll-range) * self.thumb-free : 0px;
                private property <length> drag-start-y;
                private property <length> drag-start-offset;

                // Где на полосе стоит центр ползунка, когда строка `number` (с 1) стоит наверху:
                // ровно туда прыгает ползунок по клику, поэтому отметка совпадает с ним.
                pure function tick-y(number: int) -> length {
                    return self.thumb-height / 2
                        + min(1, (number - 1) * Theme.row-height / max(1px, self.scroll-range)) * self.thumb-free;
                }
                function jump-to(number: int) {
                    list.content-y = -min(self.scroll-range, (number - 1) * Theme.row-height);
                }

                Rectangle {
                    x: 0px;
                    width: 1px;
                    background: Theme.border;
                }

                // Клик по полосе: ползунок прыгает к этому месту.
                TouchArea {
                    enabled: track.scroll-range > 0;
                    clicked => {
                        list.content-y = -min(track.scroll-range, max(0px, (self.mouse-y - track.thumb-height / 2) / track.thumb-free * track.scroll-range));
                    }
                }

                // Вехи через равные промежутки строк (шаг задаёт вызывающий) и свои вехи
                // пользователя; подсказка у каждой показывает номер строки.
                if root.milestone-step > 0 && track.scroll-range > 0 : Rectangle {
                    for k in Math.floor(root.rows.length / root.milestone-step) : TrackTick {
                        y: track.tick-y((k + 1) * root.milestone-step) - self.height / 2;
                        number: (k + 1) * root.milestone-step;
                        jump => { track.jump-to(self.number); }
                    }
                }
                if track.scroll-range > 0 : Rectangle {
                    for mark in root.marks : TrackTick {
                        y: track.tick-y(mark.row + 1) - self.height / 2;
                        number: mark.row + 1;
                        label: mark.label;
                        mine: true;
                        jump => { track.jump-to(self.number); }
                    }
                }

                if track.scroll-range > 0 : thumb := Rectangle {
                    x: 3px;
                    y: track.thumb-y;
                    width: parent.width - 6px;
                    height: track.thumb-height;
                    border-radius: 4px;
                    background: thumb-touch.pressed ? Theme.accent-text : thumb-touch.has-hover ? Theme.text-muted : Theme.border-strong;

                    thumb-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down) {
                                track.drag-start-y = self.absolute-position.y + self.mouse-y;
                                track.drag-start-offset = list.content-y;
                            }
                        }
                        moved => {
                            if (self.pressed) {
                                list.content-y = -min(track.scroll-range, max(0px, -track.drag-start-offset
                                    + (self.absolute-position.y + self.mouse-y - track.drag-start-y) / track.thumb-free * track.scroll-range));
                            }
                        }
                    }

                    // Подсказка при наведении на ползунок: где мы в списке.
                    if thumb-touch.has-hover || thumb-touch.pressed : Rectangle {
                        width: tip.preferred-width + 16px;
                        height: 24px;
                        x: -self.width - 6px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Shape.control-radius;
                        background: Theme.text;
                        tip := Text {
                            text: "Строка " + (Math.round(-list.content-y / Theme.row-height) + 1) + " из " + root.rows.length;
                            font-size: Theme.font-caption;
                            color: Theme.bg;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

            }
        }
    }

    // Меню заголовка колонки: направление сортировки и приоритет среди отсортированных колонок.
    head-menu := PopupWindow {
        x: root.head-menu-x;
        y: root.head-menu-y;
        width: MenuMetrics.width;
        height: MenuMetrics.height(6);
        close-policy: PopupClosePolicy.close-on-click-outside;

        MenuPanel {
            actions: [
                { id: "asc", label: "По возрастанию", icon: "sort-asc", danger: false, enabled: root.dir-of(root.head-menu-col) != 1, divider: false },
                { id: "desc", label: "По убыванию", icon: "sort-desc", danger: false, enabled: root.dir-of(root.head-menu-col) != 2, divider: false },
                { id: "clear", label: "Убрать сортировку", icon: "close", danger: false, enabled: root.dir-of(root.head-menu-col) != 0, divider: false },
                { id: "earlier", label: "Приоритет выше", icon: "arrow-up", danger: false, enabled: root.priority-of(root.head-menu-col) > 1, divider: true },
                { id: "later", label: "Приоритет ниже", icon: "arrow-down", danger: false, enabled: root.priority-of(root.head-menu-col) > 0 && root.priority-of(root.head-menu-col) < root.sort-count, divider: false },
                { id: "clear-all", label: "Сбросить всю сортировку", icon: "undo", danger: false, enabled: root.sort-count > 0, divider: true },
            ];
            chosen(id) => {
                root.sort-action(root.head-menu-col, id);
                head-menu.close();
            }
        }
    }

    // Меню строки по правой кнопке мыши.
    menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: MenuMetrics.width;
        height: MenuMetrics.height(root.actions.length);
        close-policy: PopupClosePolicy.close-on-click-outside;

        MenuPanel {
            actions: root.actions;
            chosen(id) => {
                root.action-chosen(root.menu-row, id);
                menu.close();
            }
        }
    }
}
