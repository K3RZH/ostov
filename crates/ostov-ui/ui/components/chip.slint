import { Theme, Shape } from "../theme.slint";

export enum ChipKind { neutral, posted, draft, error, saved, changed }

// Чип статуса: «Проведён», «Черновик», «Записан», «Проведён, изменён», «Ошибка», нейтральная метка.
export component Chip inherits Rectangle {
    in property <string> text;
    in property <ChipKind> kind: ChipKind.neutral;

    // Чип по ширине текста везде, в том числе в ячейке таблицы, где раскладки нет.
    width: label.preferred-width + 16px;
    height: 20px;
    // Скругление по настройке пользователя, но не больше половины высоты (капсула).
    border-radius: min(Shape.control-radius, self.height / 2);
    background: root.kind == ChipKind.posted ? (Theme.dark ? #24392A : #E5F3E6)
        : root.kind == ChipKind.draft ? (Theme.dark ? #403018 : #FFF3D6)
        : root.kind == ChipKind.error ? Theme.danger-soft
        : root.kind == ChipKind.saved ? (Theme.dark ? #1F2E3F : #E3EEF9)
        : root.kind == ChipKind.changed ? (Theme.dark ? #4A2E1A : #FFE4CC)
        : Theme.surface-alt;

    label := Text {
        x: 8px;
        height: 20px;
        text: root.text;
        font-size: Theme.font-caption;
        font-weight: 600;
        vertical-alignment: center;
        color: root.kind == ChipKind.posted ? (Theme.dark ? #7FD18B : #276B2B)
            : root.kind == ChipKind.draft ? (Theme.dark ? #F2C46B : #8A5A00)
            : root.kind == ChipKind.error ? Theme.danger
            : root.kind == ChipKind.saved ? (Theme.dark ? #86B8E8 : #1F5C99)
            : root.kind == ChipKind.changed ? (Theme.dark ? #F0A56B : #9A4A00)
            : Theme.text-muted;
    }
}
